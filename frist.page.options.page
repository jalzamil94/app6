import { Component, OnInit } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { IonContent, IonHeader, IonTitle, IonToolbar, IonList, IonItem, IonLabel, IonButton, IonIcon,PopoverController } from '@ionic/angular/standalone';
import { OptionsPage } from '../options/options.page';
import { IonicModule } from '@ionic/angular';

@Component({
  selector: 'app-fristpage',
  templateUrl: './fristpage.page.html',
  styleUrls: ['./fristpage.page.scss'],
  standalone: true,
  imports: [ IonicModule, CommonModule, FormsModule]
})
export class FristpagePage implements OnInit {
[x: string]: any;

  constructor(private popoverCtrl:PopoverController) { }

  ngOnInit() {
  }
 async showOptions(ev,user){
let pop=await this.popoverCtrl.create({
  component:OptionsPage,
event:ev,
componentProps:{user}
});
await pop.present()
let result=await pop.onDidDismiss();
console.log('option:' ,result.data)
  }

}
